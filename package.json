{
  "name": "human-constellation-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "test": "node --test",
    "check": "npm test && npm run build",
    "smoke:sky": "node --env-file-if-exists=.env scripts/smoke-sky.mjs",
    "test:browser": "npm run build && playwright test",
    "assets:pose": "node scripts/prepare-pose-assets.mjs",
    "prebuild": "npm run assets:pose && npm run assets:catalog",
    "predev": "npm run assets:pose && npm run assets:catalog",
    "predev:client": "npm run assets:pose && npm run assets:catalog",
    "assets:catalog": "node scripts/prepare-catalog.mjs",
    "smoke:ai": "node --env-file-if-exists=.env scripts/smoke-ai.mjs",
    "smoke:container": "node scripts/smoke-container.mjs",
    "smoke:jev": "node --env-file-if-exists=.env scripts/smoke-jev.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@openai/codex-sdk": "^0.155.1",
    "astronomy-engine": "2.1.19",
    "google-auth-library": "11.1.0",
    "hono": "^4.9.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^7.1.0"
  }
}
